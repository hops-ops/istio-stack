# code: language=yaml
#
# Initialize $state with spec defaults
#

{{- $xr := getCompositeResource . }}
{{- $spec := $xr.spec | default dict }}
{{- $metadata := $xr.metadata | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "istio" }}
{{- $clusterName := $spec.clusterName | default $name }}
{{- $namespace := $spec.namespace | default "istio-system" }}
{{- $chartVersion := $spec.chartVersion | default "1.29.2" }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}

# Labels
{{- $kindKey := printf "hops.ops.com.ai/%s" (lower $xr.kind) }}
{{- $defaultLabels := dict
  "hops.ops.com.ai/managed" "true"
  $kindKey $name
}}
{{- $labels := mergeOverwrite (dict) $defaultLabels ($spec.labels | default dict) }}

# ==============================================================================
# Provider config refs
# ==============================================================================
{{- $helmProviderConfigRef := $spec.helmProviderConfigRef | default dict }}
{{- $helmProviderConfigRef = dict
  "name" ($helmProviderConfigRef.name | default $clusterName)
  "kind" ($helmProviderConfigRef.kind | default "ProviderConfig")
}}

{{- $kubernetesProviderConfigRef := $spec.kubernetesProviderConfigRef | default dict }}
{{- $kubernetesProviderConfigRef = dict
  "name" ($kubernetesProviderConfigRef.name | default $clusterName)
  "kind" ($kubernetesProviderConfigRef.kind | default "ProviderConfig")
}}

# ==============================================================================
# Component values
# ==============================================================================
{{- $base := $spec.base | default dict }}
{{- $istiod := $spec.istiod | default dict }}
{{- $cni := $spec.cni | default dict }}
{{- $ztunnel := $spec.ztunnel | default dict }}

# ==============================================================================
# Ingress Gateway
# ==============================================================================
{{- $ig := $spec.ingressGateway | default dict }}
{{- $igEnabled := true }}
{{- if hasKey $ig "enabled" }}
  {{- $igEnabled = $ig.enabled }}
{{- end }}
{{- $igName := $ig.name | default "platform" }}
{{- $igNamespace := $ig.namespace | default "istio-ingress" }}
{{- $igGatewayClassName := $ig.gatewayClassName | default "istio" }}
{{- $igListeners := $ig.listeners | default list }}

# ==============================================================================
# AWS LBC integration
# ==============================================================================
{{- $lbc := $spec.awsLoadBalancerController | default dict }}
{{- $lbcEnabled := false }}
{{- if hasKey $lbc "enabled" }}
  {{- $lbcEnabled = $lbc.enabled }}
{{- end }}
{{- $lbcScheme := $lbc.scheme | default "internet-facing" }}
{{- $lbcTargetType := $lbc.targetType | default "ip" }}
{{- $lbcCrossZone := true }}
{{- if hasKey $lbc "crossZoneEnabled" }}
  {{- $lbcCrossZone = $lbc.crossZoneEnabled }}
{{- end }}
{{- $lbcExtraAnnotations := $lbc.additionalAnnotations | default dict }}
{{- $lbcReleaseRef := $lbc.releaseRef | default dict }}
{{- $lbcReleaseRefName := $lbcReleaseRef.name | default "" }}

# Compute the Gateway's infrastructure.annotations from LBC config.
# When LBC is enabled, Istio's Gateway controller propagates these annotations
# to the auto-generated Service so the LBC sees them and provisions an NLB.
{{- $gatewayInfraAnnotations := dict }}
{{- if $lbcEnabled }}
  {{- $gatewayInfraAnnotations = dict
    "service.beta.kubernetes.io/aws-load-balancer-type" "external"
    "service.beta.kubernetes.io/aws-load-balancer-nlb-target-type" $lbcTargetType
    "service.beta.kubernetes.io/aws-load-balancer-scheme" $lbcScheme
    "service.beta.kubernetes.io/aws-load-balancer-backend-protocol" "tcp"
    "service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled" (printf "%t" $lbcCrossZone)
  }}
  {{- if $lbcExtraAnnotations }}
    {{- $gatewayInfraAnnotations = mergeOverwrite $gatewayInfraAnnotations $lbcExtraAnnotations }}
  {{- end }}
{{- end }}

# ==============================================================================
# Initialize $state
# ==============================================================================
{{- $state := dict
  "name" $name
  "clusterName" $clusterName
  "namespace" $namespace
  "chartVersion" $chartVersion
  "managementPolicies" $managementPolicies
  "labels" $labels
  "helmProviderConfigRef" $helmProviderConfigRef
  "kubernetesProviderConfigRef" $kubernetesProviderConfigRef
  "base" (dict
    "values" ($base.values | default dict)
    "overrideAllValues" ($base.overrideAllValues | default dict)
  )
  "istiod" (dict
    "values" ($istiod.values | default dict)
    "overrideAllValues" ($istiod.overrideAllValues | default dict)
  )
  "cni" (dict
    "values" ($cni.values | default dict)
    "overrideAllValues" ($cni.overrideAllValues | default dict)
  )
  "ztunnel" (dict
    "values" ($ztunnel.values | default dict)
    "overrideAllValues" ($ztunnel.overrideAllValues | default dict)
  )
  "ingressGateway" (dict
    "enabled" $igEnabled
    "name" $igName
    "namespace" $igNamespace
    "gatewayClassName" $igGatewayClassName
    "listeners" $igListeners
    "infrastructureAnnotations" $gatewayInfraAnnotations
  )
  "awsLoadBalancerController" (dict
    "enabled" $lbcEnabled
    "releaseRef" (dict "name" $lbcReleaseRefName)
  )
  "observed" (dict)
  "status" (dict)
}}
